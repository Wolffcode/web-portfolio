---                                                                                
  import { useTranslations } from '../i18n/utils';                                                             
                                                                                                                
  interface Props {                                                                                            
    lang?: 'en' | 'es';                                                                                        
  }               

  const lang = Astro.currentLocale as 'en' | 'es';
  const path = Astro.url.pathname;                                          
   
  
  const enPath = lang === 'es' ? path.replace(/^\/es/, '') || '/' : path;
  const esPath = lang === 'en' ? `/es${path}` : path;
  const t = useTranslations(lang);
---                                                                                                          
                                                               
<nav class="fixed top-0 left-0 right-0 z-50 text-xl flex flex-row justify-between gap-8 py-4 px-8 bg-background/60 backdrop-blur-md border-b border-blue-500/25">           
  <div class="flex flex-row">
    <span>Wolffcode</span><p>.</p><span>io</span>
  </div>
  <div class="flex flew-row gap-8">
    <a class="border-b-2 border-transparent hover:border-primary hover:-translate-y-0.5 
    transition-all duration-200 " href="/">{t('nav.about')}</a>
    <a class="border-b-2 border-transparent hover:border-primary hover:-translate-y-0.5 
    transition-all duration-200 " href="#projects">{t('nav.skills')}</a>
    <a class="border-b-2 border-transparent hover:border-primary hover:-translate-y-0.5 
    transition-all duration-200 " href="#projects">{t('nav.projects')}</a>
    <a class="border-b-2 border-transparent hover:border-primary hover:-translate-y-0.5 
    transition-all duration-200 " href="#projects">{t('nav.career')}</a>
    <a class="border-b-2 border-transparent hover:border-primary hover:-translate-y-0.5 
    transition-all duration-200 " href="#projects">{t('nav.contact')}</a>  
  </div>
  <div class="flex items-center gap-1 text-sm font-medium">                 
    <a href={enPath} class={lang === 'en' ? 'text-primary' :
      'text-muted-foreground hover:text-foreground transition-colors'}>
      EN
    </a>
    <span class="text-muted-foreground">/</span>
    <a href={esPath} class={lang === 'es' ? 'text-primary' :
      'text-muted-foreground hover:text-foreground transition-colors'}>
      ES
    </a>                                                                    
  </div>                                                                
</nav>

