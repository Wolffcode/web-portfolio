---
import { useTranslations } from "../i18n/utils";
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';

interface Props {
  lang?:  'en' | 'es'
}

const lang = Astro.currentLocale as 'en' | 'es';
const t = useTranslations(lang);
const hasProjects = projects.length > 0;

const invertIcons = new Set(['Astro']);

const techIcons: Record<string, string> = {
  'React': 'devicon:react',
  'TypeScript': 'devicon:typescript',
  'JavaScript': 'devicon:javascript',
  'Tailwind': 'devicon:tailwindcss',
  'Webpack': 'devicon:webpack',
  'Module Federation': 'devicon:webpack',
  'AWS': 'devicon:amazonwebservices-wordmark',
  'AWS QuickSight': 'devicon:amazonwebservices-wordmark',
  'Recharts': 'devicon:javascript',
  'Docker': 'devicon:docker',
  'Git': 'devicon:git',
  'Astro': 'devicon:astro',
  'Node.js': 'devicon:nodejs',
  'Next.js': 'devicon:nextjs',
  'Vue': 'devicon:vuejs',
  'Python': 'devicon:python',
};
---

<section id="projects" class="min-h-screen flex flex-col justify-center px-5 sm:px-8 lg:px-20 py-14 lg:py-24 gap-8 md:gap-12">

  <div class="flex flex-col gap-2">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold gradient-text leading-tight">{t('projects.title')}</h2>
  </div>

  {hasProjects ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {projects.map((project) => {
        const t = project.translations[lang];
        return (
        <article
          class="group relative overflow-hidden rounded-xl aspect-video cursor-pointer border border-white/5 transition-all duration-300 hover:border-primary/40 hover:shadow-[0_0_40px_-10px_var(--color-glow)]"
          data-project-id={project.id}
          data-title={t.title}
          data-description={t.description}
          data-link={project.link}
          data-repo={project.repo}
          data-image={project.image ?? ''}
        >
          <!-- Background -->
          {project.image ? (
            <img
              src={project.image}
              alt={t.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-primary/30 via-accent/10 to-background transition-transform duration-500 group-hover:scale-105">
              <span class="absolute inset-0 flex items-center justify-center text-9xl font-black text-primary/5 select-none uppercase tracking-tighter">
                {t.title.slice(0, 2)}
              </span>
            </div>
          )}

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />

          <!-- Bottom bar -->
          <div class="absolute bottom-0 left-0 right-0 p-5 flex items-end justify-between gap-4">
            <h3 class="text-white font-semibold text-lg leading-tight drop-shadow-lg">
              {t.title}
            </h3>
            <div class="flex gap-1.5 opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 shrink-0">
              {project.tags.map((tag: string) => (
                techIcons[tag] ? (
                  <div class="w-7 h-7 rounded-md bg-black/60 backdrop-blur-sm border border-white/10 flex items-center justify-center" title={tag}>
                    <Icon name={techIcons[tag]} class={`w-4 h-4${invertIcons.has(tag) ? ' brightness-0 invert' : ''}`} />
                  </div>
                ) : (
                  <div class="px-2 h-7 rounded-md bg-black/60 backdrop-blur-sm border border-white/10 flex items-center" title={tag}>
                    <span class="text-[10px] text-white/70">{tag}</span>
                  </div>
                )
              ))}
            </div>
          </div>
        </article>
        );
      })}
    </div>
  ) : (
    <div class="flex flex-col items-center justify-center gap-6 py-12">
      <img
        src="/building.webp"
        alt="Proyectos en construcción"
        class="w-[42rem] opacity-30 grayscale"
      />
      <p class="text-muted-foreground text-sm tracking-wide">{t('projects.noprojectstitle')}</p>
    </div>
  )}

</section>

<!-- Pre-rendered tech stacks (hidden, cloned into modal via JS) -->
<div class="hidden" aria-hidden="true">
  {projects.map((project) => (
    <div id={`stack-${project.id}`}>
      {project.tags.map((tag: string) => (
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-secondary/60 border border-border/40">
          {techIcons[tag] && <Icon name={techIcons[tag]} class={`w-4 h-4 shrink-0${invertIcons.has(tag) ? ' brightness-0 invert' : ''}`} />}
          <span class="text-xs text-muted-foreground">{tag}</span>
        </div>
      ))}
    </div>
  ))}
</div>

<!-- Pre-rendered image placeholders (hidden, cloned into modal via JS) -->
<div class="hidden" aria-hidden="true">
  {projects.map((project) => (
    <div id={`placeholder-${project.id}`} class="w-full h-full bg-gradient-to-br from-primary/30 via-accent/10 to-background flex items-center justify-center">
      <span class="text-8xl font-black text-primary/10 select-none uppercase tracking-tighter">
        {project.translations[lang].title.slice(0, 2)}
      </span>
    </div>
  ))}
</div>

<!-- Modal -->
<div
  id="project-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-6 bg-black/60 backdrop-blur-sm"
>
  <div
    id="modal-card"
    class="relative bg-card border border-primary/30 rounded-2xl overflow-hidden max-w-2xl w-full shadow-[0_0_80px_-10px_var(--color-glow)] flex flex-col"
  >
    <!-- Image area -->
    <div id="modal-image-area" class="relative h-56 overflow-hidden shrink-0">
      <div id="modal-overlay-gradient" class="absolute inset-0 bg-gradient-to-t from-card/80 to-transparent z-10" />
    </div>

    <button
      id="modal-close"
      class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-black/50 backdrop-blur-sm border border-white/10 flex items-center justify-center text-white/70 hover:text-white transition-colors text-sm"
    >✕</button>

    <!-- Content -->
    <div class="p-7 flex flex-col gap-5">
      <h3 id="modal-title" class="text-2xl font-bold gradient-text"></h3>
      <p id="modal-description" class="text-muted-foreground text-sm leading-relaxed"></p>

      <!-- Tech stack -->
      <div class="flex flex-col gap-2">
        <span class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Stack</span>
        <div id="modal-stack" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Links -->
      <div class="flex gap-4 pt-4 border-t border-border/40">
        <a id="modal-link" href="#" target="_blank" class="text-sm font-medium text-primary hover:underline transition-colors">
          Demo →
        </a>
        <a id="modal-repo" href="#" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          {t('projects.repository')}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('project-modal')!;
  const modalCard = document.getElementById('modal-card')!;
  const modalImageArea = document.getElementById('modal-image-area')!;
  const modalStack = document.getElementById('modal-stack')!;

  function openModal(card: HTMLElement) {
    const id = card.dataset.projectId!;
    const image = card.dataset.image;

    // Title / description / links
    (document.getElementById('modal-title') as HTMLElement).textContent = card.dataset.title ?? '';
    (document.getElementById('modal-description') as HTMLElement).textContent = card.dataset.description ?? '';
    (document.getElementById('modal-link') as HTMLAnchorElement).href = card.dataset.link ?? '#';
    (document.getElementById('modal-repo') as HTMLAnchorElement).href = card.dataset.repo ?? '#';

    // Image area: remove previous content, insert before the fixed gradient overlay
    const gradientOverlay = document.getElementById('modal-overlay-gradient')!;
    modalImageArea.querySelector('img')?.remove();
    modalImageArea.querySelector('[data-modal-placeholder]')?.remove();

    if (image) {
      const img = document.createElement('img');
      img.src = image;
      img.alt = card.dataset.title ?? '';
      img.className = 'absolute inset-0 w-full h-full object-cover';
      modalImageArea.insertBefore(img, gradientOverlay);
    } else {
      const placeholderSource = document.getElementById(`placeholder-${id}`);
      if (placeholderSource) {
        const clone = placeholderSource.cloneNode(true) as HTMLElement;
        clone.removeAttribute('id');
        clone.setAttribute('data-modal-placeholder', '');
        clone.className = 'absolute inset-0 w-full h-full ' + clone.className;
        modalImageArea.insertBefore(clone, gradientOverlay);
      }
    }

    // Tech stack
    modalStack.innerHTML = '';
    const stackSource = document.getElementById(`stack-${id}`);
    if (stackSource) {
      stackSource.childNodes.forEach((node) => {
        modalStack.appendChild(node.cloneNode(true));
      });
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.querySelectorAll<HTMLElement>('article[data-project-id]').forEach((card) => {
    card.addEventListener('click', () => openModal(card));
  });

  document.getElementById('modal-close')!.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (!modalCard.contains(e.target as Node)) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
