---
import { useTranslations } from "../i18n/utils";
const email = 'carlosrendon9814@gmail.com';
const linkedin = 'https://www.linkedin.com/in/carlos-moreno-4719a3212/';

const lang = Astro.currentLocale as 'en' | 'es';
const t = useTranslations(lang);
---

<section id="contact" class="flex flex-col items-center gap-10 px-20 py-24 border-t border-border/40">

  <div class="flex flex-col items-center gap-3 text-center">
    <span class="text-xs font-medium tracking-widest uppercase text-muted-foreground">{t('contact.title')}</span>
    <h2 class="text-4xl font-bold gradient-text leading-tight">{t('contact.p1')}</h2>
    <p class="text-muted-foreground text-sm max-w-md leading-relaxed">{t('contact.p2')}</p>
  </div>

  <div class="flex gap-4">

    <!-- LinkedIn -->
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 px-6 py-3 rounded-xl bg-card border border-primary/20 text-foreground hover:border-primary/50 hover:shadow-[0_0_24px_-8px_var(--color-glow)] transition-all duration-300"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
      <span class="text-sm font-medium">LinkedIn</span>
    </a>

    <!-- Email -->
    <a
      href={`mailto:${email}`}
      class="flex items-center gap-3 px-6 py-3 rounded-xl bg-card border border-primary/20 text-foreground hover:border-primary/50 hover:shadow-[0_0_24px_-8px_var(--color-glow)] transition-all duration-300"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <span class="text-sm font-medium">{email}</span>
    </a>

  </div>

</section>
