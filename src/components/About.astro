---
import { useTranslations } from "../i18n/utils";
import { Icon } from 'astro-icon/components';

interface Props {
  lang?:  'en' | 'es'
}

  const lang = Astro.currentLocale as 'en' | 'es';
  const t = useTranslations(lang);

const mainStack = [
  { name: 'TypeScript', icon: 'devicon:typescript' },
  { name: 'React', icon: 'devicon:react' },
  { name: 'Tailwind', icon: 'devicon:tailwindcss' },
  { name: 'Webpack', icon: 'devicon:webpack' },
  { name: 'Git', icon: 'devicon:git' },
  { name: 'Module Federation', icon: null },
];

const secondary = [
  { name: 'AWS (Fargate, S3, Route53, CloudFront, Quicksight)', icon: 'devicon:amazonwebservices-wordmark', invert: false },
  { name: 'Docker', icon: 'devicon:docker', invert: false },
  { name: 'CI/CD con Jenkins', icon: 'devicon:jenkins', invert: false },
  { name: 'Astro', icon: 'devicon:astro', invert: true },
];
---

<section id="about" class="min-h-screen grid grid-cols-2 gap-16 px-20 py-24">

  <!-- Stack -->
  <div class="flex flex-col justify-center gap-10">

    <div class="flex flex-col gap-4">
      <span class="text-xs font-medium tracking-widest uppercase text-muted-foreground">{t('about.stack')}</span>
      <div class="grid grid-cols-3 gap-3">
        {mainStack.map((tech) => (
          <div class="flex flex-col items-center justify-center gap-3 p-4 rounded-xl bg-card border border-primary/40">
            {tech.icon
              ? <Icon name={tech.icon} class="w-8 h-8" />
              : <span class="text-lg font-bold text-muted-foreground">MF</span>
            }
            <span class="text-xs text-center text-muted-foreground">
              {tech.name}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <span class="text-xs font-medium tracking-widest uppercase text-muted-foreground">{t('about.workwith')}</span>
      <ul class="flex flex-col gap-2">
        {secondary.map((tech) => (
          <li class="flex items-center gap-3 text-foreground/60 text-base">
            {tech.icon
              ? <Icon name={tech.icon} class={`w-6 h-6 shrink-0${tech.invert ? ' brightness-0 invert' : ''}`} />
              : <span class="w-6 h-6 shrink-0" />
            }
            {tech.name}
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- About me -->
  <div class="flex flex-col justify-center gap-6">
    <div class="flex flex-col gap-2">
      <span class="text-l font-medium tracking-widest uppercase text-muted-foreground gradient-text leading-tight">{t('about.about')}</span>
      <h2 class="text-4xl font-bold gradient-text leading-tight">Fullstack developer</h2>
      <p class="text-muted-foreground text-sm">{t('hero.experience')}</p>
    </div>

    <div class="flex flex-col gap-4 text-foreground/70 text-base leading-relaxed">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <p>{t('about.p3')}</p>
    </div>
  </div>

</section>
